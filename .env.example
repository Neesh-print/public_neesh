# Public site URL, absolute, https, no trailing slash. Used for canonicals,
# JSON-LD, the sitemap, and OG URLs.
NEXT_PUBLIC_SITE_URL=https://neesh.art

# Supabase (Neesh project)
NEXT_PUBLIC_SUPABASE_URL=https://smfzrubkyxejzkblrrjr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only. Required by /api/signal, /api/claim, /out, middleware,
# and the import/remove scripts.
SUPABASE_SERVICE_ROLE_KEY=

# Secret for the daily-rotating IP hash salt (any long random string).
# Unset, no IP hash is stored with demand signals.
SIGNAL_SALT_SECRET=

# Token protecting POST /api/revalidate. Sent only as an
# Authorization: Bearer header.
REVALIDATE_TOKEN=

# Optional notification email plumbing (Resend). Leave unset to disable email.
# Sender is Neesh <hi@neesh.art>, reply-to monitored by a person.
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Neesh <hi@neesh.art>
NOTIFY_REPLY_TO=hi@neesh.art

# Used by scripts/remove.ts to hit the deployed revalidate route.
REVALIDATE_URL=https://neesh.art/api/revalidate

# Shared rate-limit counters (Upstash for Redis via the Vercel Marketplace,
# which sets KV_REST_API_URL and KV_REST_API_TOKEN; either pair works).
# Unset, limits fall back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error alerts go by email to ALERT_EMAIL (default NOTIFY_EMAIL) and to every
# admin's notifications on the admin dashboard; optionally also to a Slack or
# Discord webhook.
ALERT_EMAIL=
ALERT_WEBHOOK_URL=

# Your collection (/collect). Bearer token Vercel Cron sends to the notify
# route, and the key that signs unfollow and account-deletion links (unset,
# the service role key is used).
CRON_SECRET=
COLLECT_LINK_SECRET=

# HubSpot newsletter sync (/api/cron/hubspot-sync, docs/operations.md
# section 12): a private app token and the newsletter subscription type id.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_SUBSCRIPTION_ID=
