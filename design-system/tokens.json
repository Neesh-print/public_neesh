{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Neesh",
  "description": "Design tokens for neesh.art. Shared by the Next.js site (public_neesh) and the React app (neesh-print-hub). Hex values are canonical; the hsl triplets are what the app's tailwind.config.ts consumes via hsl(var(--x)).",
  "color": {
    "ink": { "$value": "#000000", "$type": "color", "hsl": "0 0% 0%", "$description": "Text, primary buttons, black bands" },
    "paper": { "$value": "#ffffff", "$type": "color", "hsl": "0 0% 100%", "$description": "Page and card background" },
    "accent": { "$value": "#7d3bbf", "$type": "color", "hsl": "270 53% 49%", "$description": "Purple. Eyebrows, focus, hover, purple buttons, wholesale price" },
    "accent-light": { "$value": "#a87bd6", "$type": "color", "$description": "Accent on black only" },
    "band": { "$value": "#efeef6", "$type": "color", "hsl": "245 33% 95%", "$description": "Cream tint. App secondary, muted and input surfaces" },
    "band-hover": { "$value": "#e4e2f0", "$type": "color" },
    "border": { "$value": "#d9d9d9", "$type": "color", "hsl": "0 0% 85%" },
    "border-hover": { "$value": "#b79adb", "$type": "color" },
    "prose": { "$value": "#2a2c33", "$type": "color" },
    "muted": { "$value": "#5c5f6b", "$type": "color" },
    "muted-2": { "$value": "#71747f", "$type": "color", "hsl": "230 6% 47%", "$description": "App muted-foreground" },
    "faint": { "$value": "#9b9da6", "$type": "color" },
    "faintest": { "$value": "#b9bac3", "$type": "color" },
    "upload-border": { "$value": "#c9cad2", "$type": "color" },
    "on-black": { "$value": "rgba(255,255,255,0.86)", "$type": "color" },
    "on-black-soft": { "$value": "rgba(255,255,255,0.72)", "$type": "color" },
    "hairline-on-black": { "$value": "rgba(255,255,255,0.2)", "$type": "color" },
    "destructive": { "$value": "#ef4444", "$type": "color", "hsl": "0 84% 60%" },
    "form-error": { "$value": "#b3261e", "$type": "color" },
    "chart-green": { "$value": "#10b981", "$type": "color", "hsl": "160 84% 39%" },
    "status": {
      "pending": { "bg": "#fef3c7", "text": "#854d0e", "hsl-bg": "45 93% 89%", "hsl-text": "32 81% 29%" },
      "success": { "bg": "#d1fae5", "text": "#047857", "hsl-bg": "149 80% 90%", "hsl-text": "160 84% 24%" },
      "error": { "bg": "#fee2e2", "text": "#dc2626", "hsl-bg": "0 93% 94%", "hsl-text": "0 72% 51%" },
      "neutral": { "bg": "#e5e7eb", "text": "#71747f", "hsl-bg": "220 14% 91%", "hsl-text": "230 6% 47%" },
      "warning": { "bg": "#f59e0b", "text": "#92400e" }
    }
  },
  "font": {
    "display": { "$value": "Archivo, system-ui, sans-serif", "$type": "fontFamily", "axes": { "wdth": "62..125", "wght": "100..900" }, "$description": "Variable width. Site headings use wdth 106 to 122; the app pins 114." },
    "body": { "$value": "Manrope, system-ui, sans-serif", "$type": "fontFamily", "weights": [400, 500, 600, 700] },
    "mono": { "$value": "'IBM Plex Mono', ui-monospace, monospace", "$type": "fontFamily", "weights": [400, 500] },
    "googleFonts": "https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&display=swap"
  },
  "type": {
    "site": {
      "d1": { "family": "display", "weight": 800, "wdth": 112, "size": "clamp(40px, 6.4vw, 104px)", "lineHeight": 0.9, "letterSpacing": "-0.038em" },
      "d2": { "family": "display", "weight": 700, "wdth": 118, "size": "clamp(32px, 4.4vw, 64px)", "lineHeight": 0.98, "letterSpacing": "-0.034em" },
      "d3": { "family": "display", "weight": 700, "wdth": 116, "size": "clamp(22px, 2.4vw, 34px)", "lineHeight": 1.04, "letterSpacing": "-0.026em" },
      "lede": { "family": "body", "weight": 400, "size": "18px", "lineHeight": 1.55, "color": "muted", "maxWidth": "46ch" },
      "body": { "family": "body", "weight": 400, "size": "16px", "lineHeight": 1.55 },
      "eyebrow": { "family": "mono", "weight": 500, "size": "12px", "letterSpacing": "0.14em", "transform": "uppercase" },
      "nav": { "family": "mono", "weight": 400, "size": "12px", "letterSpacing": "0.08em", "transform": "uppercase" },
      "manifesto-h2": { "family": "display", "weight": 800, "wdth": 122, "size": "clamp(42px, 7.4vw, 116px)", "lineHeight": 0.9, "letterSpacing": "-0.04em" }
    },
    "app": {
      "display-lg": { "size": "2.5rem", "lineHeight": 1.1, "weight": 700 },
      "display-md": { "size": "2rem", "lineHeight": 1.2, "weight": 700 },
      "display-sm": { "size": "1.5rem", "lineHeight": 1.25, "weight": 600 },
      "heading": { "size": "1.25rem", "lineHeight": 1.4, "weight": 600 },
      "body-lg": { "size": "1rem", "lineHeight": 1.5, "weight": 400 },
      "body": { "size": "0.875rem", "lineHeight": 1.5, "weight": 400 },
      "caption": { "size": "0.75rem", "lineHeight": 1.4, "weight": 400 },
      "headingWdth": 114,
      "headingLetterSpacing": "-0.02em"
    }
  },
  "radius": {
    "sm": { "$value": "4px", "$description": "Index covers, status badges" },
    "md": { "$value": "8px", "$description": "Buttons, fields, cards, app covers" },
    "lg": { "$value": "12px", "$description": "Modals" },
    "pill": { "$value": "999px", "$description": "Chips, pills, search field, menu button" }
  },
  "layout": {
    "wrapMax": "1600px",
    "gutter": "clamp(18px, 3.4vw, 56px)",
    "sectionPad": "clamp(56px, 7vw, 110px)",
    "breakpoint": "900px",
    "marketingHeaderHeight": "74px",
    "directoryHeaderRows": ["62px", "44px"],
    "appHeaderHeight": "64px",
    "appSidebarWidth": "240px",
    "appContainerMax": "1400px"
  },
  "shadow": {
    "site": "none",
    "neesh": "0 1px 3px 0 rgb(0 0 0 / 0.05)",
    "neesh-md": "0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05)",
    "neesh-lg": "0 10px 15px -3px rgb(0 0 0 / 0.05), 0 4px 6px -4px rgb(0 0 0 / 0.05)"
  },
  "motion": {
    "color": "160ms ease",
    "nudge": "cubic-bezier(0.22, 1, 0.36, 1)",
    "coverZoom": "460ms",
    "drawerLink": "220ms",
    "marquee": "54s linear",
    "reducedMotion": "all animation and transition disabled"
  }
}
